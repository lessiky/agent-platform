# 记忆模块 (检索注入 / 自动抽取 + 滚动摘要)
MEMORY_ENABLED=true
MEMORY_MAX_INJECT=10
MEMORY_CHAR_BUDGET=800
MEMORY_RETRIEVAL_TIMEOUT=500ms
MEMORY_CACHE_TTL=60s
MEMORY_EXTRACT_ENABLED=true
MEMORY_EXTRACT_MIN_TURNS=5
# 抽取/摘要用 ModelTemplate 名称 (空 = Agent 当前模型)
# 注意: 平台设置页的 "记忆抽取/会话摘要模型" 优先级更高且免重启生效 (platform_settings.memory_extract_model 覆盖此值)
MEMORY_EXTRACT_MODEL=
MEMORY_MAX_ACTIVE_PER_SCOPE=500
MEMORY_SESSION_SUMMARY_THRESHOLD=40
# 语义检索: 向量专用 ModelTemplate 名称 (OpenAI 兼容 /embeddings 端点); 留空 = 纯关键词检索 (语义检索不生效)
# 注意: 平台设置页的 "记忆语义检索模型" 优先级更高且免重启生效 (platform_settings.memory_embed_model 覆盖此值)
MEMORY_EMBED_MODEL=
# M10.3 向量计算单次超时 (查询/写入/回填)
MEMORY_EMBED_TIMEOUT=10s
